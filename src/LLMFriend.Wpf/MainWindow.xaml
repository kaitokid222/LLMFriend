<Window x:Class="LLMFriend.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LLMFriend.Wpf"
        Title="LLMFriend – Konten" Height="720" Width="1150" MinHeight="580" MinWidth="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="LLMFriend" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding SignedInAs}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseVisibility}}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="24" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Anmelden" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="API-Adresse"/><TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="Nutzername"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="Passwort"/><PasswordBox x:Name="LoginPassword" Margin="0,4,0,16"/>
                <Button Content="Anmelden" Click="Login_Click" HorizontalAlignment="Right" MinWidth="110" IsDefault="True"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Visibility="{Binding NeedsPasswordChange, Converter={StaticResource BoolVisibility}}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="24" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Startpasswort ändern" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Bisheriges Passwort"/><PasswordBox x:Name="CurrentPassword" Margin="0,4,0,12"/>
                <TextBlock Text="Neues Passwort (mindestens 12 Zeichen)"/><PasswordBox x:Name="NewPassword" Margin="0,4,0,16"/>
                <Button Content="Passwort ändern" Click="ChangePassword_Click" HorizontalAlignment="Right" MinWidth="130"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding CanUseApp, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Konten laden" Command="{Binding ReloadCommand}" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="Discord verbinden" Command="{Binding LinkCommand}" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="Abmelden" Command="{Binding LogoutCommand}" Padding="10,5"/>
                </WrapPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dienst" Binding="{Binding Provider}" Width="80"/>
                        <DataGridTextColumn Header="Konto" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Inhaber" Binding="{Binding OwnerUsername}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Letzte Prüfung" Binding="{Binding LastCheckedLocal}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <TabControl Grid.Column="1">
                <TabItem Header="Konto">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAccount.DisplayName}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedAccount.Username}" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedAccount.LastError}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,8">
                            <Button Content="Jetzt prüfen" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="8,4"/>
                            <Button Content="Trennen" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" Padding="8,4"/>
                            <Button Content="Löschen" Command="{Binding DeleteCommand}" Padding="8,4"/>
                        </WrapPanel>
                        <GroupBox Grid.Row="2" Header="Discord-Server"><ListBox ItemsSource="{Binding Guilds}" DisplayMemberPath="Name"/></GroupBox>
                    </Grid>
                </TabItem>
                <TabItem Header="Verlauf">
                    <DockPanel Margin="12">
                        <Button DockPanel.Dock="Bottom" Content="Ältere Ereignisse laden" Command="{Binding MoreEventsCommand}" Margin="0,8,0,0" Padding="8,4"/>
                        <ListBox ItemsSource="{Binding Events}" DisplayMemberPath="Display"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Freigaben">
                    <StackPanel Margin="12">
                        <TextBlock Text="Bearbeiter können prüfen, freigeben und trennen. Tokens werden nicht angezeigt." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding DirectoryUsers}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username" Margin="0,0,0,8"/>
                        <Button Content="Nutzer hinzufügen" Command="{Binding ShareCommand}" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,14"/>
                        <TextBlock Text="Freigegeben für" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Shares}" SelectedItem="{Binding SelectedShare}" DisplayMemberPath="Username" Height="160" Margin="0,6,0,8"/>
                        <Button Content="Freigabe entfernen" Command="{Binding UnshareCommand}" HorizontalAlignment="Left" Padding="8,4"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Verwaltung" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Margin="12">
                        <TextBlock Text="Nutzerzugänge" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Button Content="Nutzer anlegen" Command="{Binding CreateUserCommand}" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,12"/>
                        <TextBlock Text="Passwort zurücksetzen für" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding DirectoryUsers}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username" Margin="0,0,0,10"/>
                        <Button Content="Passwort zurücksetzen" Command="{Binding ResetPasswordCommand}" HorizontalAlignment="Left" Padding="8,4"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,12,0,0" Foreground="#374151" TextWrapping="Wrap"/>
    </Grid>
</Window>
