# Set these in the API and headless service environment; never commit real values.
LLMFRIEND_DB=Server=127.0.0.1;Port=3306;Database=llmfriend;User ID=llmfriend;Password=replace-me;SslMode=Preferred
LLMFRIEND_ENCRYPTION_KEY=base64-encoded-32-random-bytes
LLMFRIEND_DISCORD_CLIENT_ID=discord-application-id
LLMFRIEND_DISCORD_CLIENT_SECRET=discord-client-secret
LLMFRIEND_DISCORD_REDIRECT_URI=https://your-api.example/api/accounts/discord/callback
# Development database only:
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PASSWORD=replace-me
